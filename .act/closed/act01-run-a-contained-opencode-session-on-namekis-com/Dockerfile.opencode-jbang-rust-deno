FROM ghcr.io/anomalyco/opencode@sha256:f4cfe16d91efbbfca01a51c44094fba4cf82e15c7fa17de5f11f9059699b1e6e

USER root
RUN apk add --no-cache git openssh-client tmux curl bash openjdk21-jdk rust cargo deno build-base \
    && addgroup -g 1000 agent \
    && adduser -D -u 1000 -G agent -h /home/agent agent \
    && mkdir -p /home/agent/workspace \
    && chown -R 1000:1000 /home/agent
ENV HOME=/home/agent TERM=xterm-256color
USER 1000:1000
RUN curl -fsSL https://sh.jbang.dev -o /tmp/install-jbang \
    && /bin/bash /tmp/install-jbang app setup \
    && rm /tmp/install-jbang
ENV PATH=/home/agent/.jbang/bin:${PATH}
WORKDIR /home/agent/workspace
ENTRYPOINT ["/bin/sh"]
CMD ["-c", "exec sleep infinity"]
